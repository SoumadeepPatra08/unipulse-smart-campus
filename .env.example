# =========================================================================
# UniPulse Campus Companion Platform - Environment Configuration
# =========================================================================

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite; supports PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./unipulse.db

# Authentication & Security
# IMPORTANT: Generate a high-entropy secret in production (e.g., openssl rand -hex 32)
JWT_SECRET=unipulse-super-secret-production-jwt-key-2026
JWT_EXPIRY_DAYS=7
COOKIE_SECURE=false # Set to true in production over HTTPS

# AI Intelligence Providers (Server-Side Only)
# Optional: Provide Anthropic API key for live Claude 3.5 Sonnet streaming
# If omitted, UniPulse seamlessly defaults to the deterministic intelligent campus engine
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase / Cloud Storage (Optional for Cloud Deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
